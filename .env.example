# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL connection string for the Docker Compose database (npm run db:up).
# Local development credentials only; matches docker-compose.yml (host port 5436).
DATABASE_URL="postgresql://records:records@localhost:5436/records"

# Base URL of the running app. Port 3004 because 3001-3003 are used by auth-slice,
# payment-slice and ai-slice.
APP_URL="http://localhost:3004"

# Server-only secret. At least 32 random bytes, base64url-encoded. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
